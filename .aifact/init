#!/usr/bin/env bash
set -euo pipefail

# AiFact Framework Activation Script
# This script generates harness-specific pointer files that reference
# the implementations within .aifact/harnesses/

SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
ROOT_DIR="$(pwd)"

FORCE=false
HARNESS=""

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -f|--force)
            FORCE=true
            shift
            ;;
        opencode|vibe)
            if [[ -n "$HARNESS" ]]; then
                echo "Error: Only one harness can be specified"
                exit 1
            fi
            HARNESS="$1"
            shift
            ;;
        *)
            echo "Usage: $0 [opencode|vibe] [-f|--force]"
            echo ""
            echo "Activate AiFact framework by creating harness-specific pointer files."
            echo ""
            echo "Arguments:"
            echo "  opencode    Create pointer files for OpenCode harness"
            echo "  vibe        Create pointer files for Mistral Vibe harness"
            echo "  -f, --force Skip confirmation prompts"
            exit 1
            ;;
    esac
done

# Validate harness is specified
if [[ -z "$HARNESS" ]]; then
    echo "Error: Harness not specified. Use 'opencode' or 'vibe'."
    exit 1
fi

# Validate .aifact directory exists
if [[ ! -d "$SCRIPT_DIR" || ! -f "$SCRIPT_DIR/README.md" ]]; then
    echo "Error: .aifact directory not found or invalid at $SCRIPT_DIR"
    exit 1
fi

# Define harness-specific configurations
declare -A HARNESS_CONFIG
HARNESS_CONFIG[opencode,target_dir]=".opencode"
HARNESS_CONFIG[opencode,source_dir]="$SCRIPT_DIR/harnesses/opencode"
HARNESS_CONFIG[vibe,target_dir]=".vibe"
HARNESS_CONFIG[vibe,source_dir]="$SCRIPT_DIR/harnesses/vibe"

TARGET_DIR="${HARNESS_CONFIG[$HARNESS,target_dir]}"
SOURCE_DIR="${HARNESS_CONFIG[$HARNESS,source_dir]}"

# Validate source directory exists
if [[ ! -d "$SOURCE_DIR" ]]; then
    echo "Error: Source directory not found: $SOURCE_DIR"
    exit 1
fi

# Check if target directory exists and prompt if needed
if [[ -d "$TARGET_DIR" || -f "$TARGET_DIR" ]]; then
    if [[ "$FORCE" != true ]]; then
        read -p "Target directory '$TARGET_DIR' already exists. Overwrite? [y/N] " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "Aborted."
            exit 0
        fi
    fi
fi

# Create target directory if it doesn't exist
mkdir -p "$TARGET_DIR"

# Define the pointer files to create
# Format: target_path,source_path
POINTER_FILES=(
    # OpenCode specific
    "$TARGET_DIR/agent/brainstorm.md:$SOURCE_DIR/agent/brainstorm.md"
    "$TARGET_DIR/agent/story-analyzer.md:$SOURCE_DIR/agent/story-analyzer.md"
    "$TARGET_DIR/agent/story-implementer.md:$SOURCE_DIR/agent/story-implementer.md"
    "$TARGET_DIR/agent/story-reviewer.md:$SOURCE_DIR/agent/story-reviewer.md"
    "$TARGET_DIR/agent/story-start.md:$SOURCE_DIR/agent/story-start.md"
    "$TARGET_DIR/agent/story-validator.md:$SOURCE_DIR/agent/story-validator.md"
    "$TARGET_DIR/commands/commit.md:$SOURCE_DIR/commands/commit.md"
    "$TARGET_DIR/commands/create-guideline.md:$SOURCE_DIR/commands/create-guideline.md"
    "$TARGET_DIR/commands/refresh-project-config.md:$SOURCE_DIR/commands/refresh-project-config.md"
    "$TARGET_DIR/commands/init.md:$SOURCE_DIR/commands/init.md"
    "$TARGET_DIR/skills/record-story.md:$SOURCE_DIR/skills/record-story.md"
)

if [[ "$HARNESS" == "vibe" ]]; then
    # For Vibe, create skills subdirectories with SKILL.md files
    POINTER_FILES=(
        "$TARGET_DIR/skills/brainstorm/SKILL.md:$SOURCE_DIR/skills/brainstorm/SKILL.md"
        "$TARGET_DIR/skills/commit/SKILL.md:$SOURCE_DIR/skills/commit/SKILL.md"
        "$TARGET_DIR/skills/create-guideline/SKILL.md:$SOURCE_DIR/skills/create-guideline/SKILL.md"
        "$TARGET_DIR/skills/refresh-project-config/SKILL.md:$SOURCE_DIR/skills/refresh-project-config/SKILL.md"
        "$TARGET_DIR/skills/record-story/SKILL.md:$SOURCE_DIR/skills/record-story/SKILL.md"
        "$TARGET_DIR/skills/story-analyzer/SKILL.md:$SOURCE_DIR/skills/story-analyzer/SKILL.md"
        "$TARGET_DIR/skills/story-implementer/SKILL.md:$SOURCE_DIR/skills/story-implementer/SKILL.md"
        "$TARGET_DIR/skills/story-reviewer/SKILL.md:$SOURCE_DIR/skills/story-reviewer/SKILL.md"
        "$TARGET_DIR/skills/story-start/SKILL.md:$SOURCE_DIR/skills/story-start/SKILL.md"
        "$TARGET_DIR/skills/story-validator/SKILL.md:$SOURCE_DIR/skills/story-validator/SKILL.md"
    )
fi

# Function to create a pointer file
create_pointer() {
    local target_path="$1"
    local source_path="$2"
    
    # Create parent directory if it doesn't exist
    local target_dir="$(dirname "$target_path")"
    mkdir -p "$target_dir"
    
    # Check if target already exists
    if [[ -f "$target_path" ]]; then
        if [[ "$FORCE" != true ]]; then
            read -p "Pointer file '$target_path' already exists. Overwrite? [y/N] " -n 1 -r
            echo
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                echo "Skipped: $target_path"
                return 1
            fi
        fi
    fi
    
    # Create symbolic link to the source file
    # Note: Using absolute path for reliability across different working directories
    local absolute_source="$(cd "$(dirname "$source_path")" && pwd)/$(basename "$source_path")"
    ln -sf "$absolute_source" "$target_path"
    
    echo "Created pointer: $target_path -> $source_path"
}

# Create all pointer files
echo "Activating AiFact framework for $HARNESS harness..."
echo ""

created_count=0
skipped_count=0

for pointer in "${POINTER_FILES[@]}"; do
    IFS=':' read -r target source <<< "$pointer"
    if create_pointer "$target" "$source"; then
        ((created_count++))
    else
        ((skipped_count++))
    fi
done

echo ""
echo "Activation complete!"
echo "Created $created_count pointer files, skipped $skipped_count"
echo ""
echo "Pointer files reference implementations in: $SOURCE_DIR"
echo "You can now use the $HARNESS harness with AiFact workflows."
